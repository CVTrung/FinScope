# Repository-root context. Requires the deployed API URL at build time.
FROM node:22-alpine AS web-deps
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:22-alpine AS web-builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
RUN node -e "const message='Set NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_SERVICE.run.app/api at build time'; if(!URL.canParse(process.env.NEXT_PUBLIC_API_BASE_URL)) throw Error(message); const u=new URL(process.env.NEXT_PUBLIC_API_BASE_URL); if(u.protocol!=='https:' || ['localhost','127.0.0.1','[::1]'].includes(u.hostname) || u.pathname!=='/api' || u.search || u.hash || u.username || u.password) throw Error('Set NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_SERVICE.run.app/api');"
COPY --from=web-deps /app/node_modules ./node_modules
COPY web/ ./
RUN npm run build

FROM node:22-alpine AS web
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=8080 HOSTNAME=0.0.0.0
COPY --from=web-builder --chown=node:node /app/.next/standalone ./
COPY --from=web-builder --chown=node:node /app/.next/static ./.next/static
USER node
EXPOSE 8080
CMD ["node", "server.js"]
